#!/usr/bin/env bash
# Lanceur Grok Forge — TUI par défaut, --plain pour le wizard bash.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

if [[ "${1:-}" == "--plain" || "${1:-}" == "--cli" ]]; then
  shift
  exec bash "$HERE/setup-grok-forge.sh" "$@"
fi

if ! command -v python3 >/dev/null; then
  echo "python3 requis pour la TUI. Fallback wizard : $0 --plain"
  exec bash "$HERE/setup-grok-forge.sh"
fi

PY="$HERE/.venv/bin/python"
if [[ ! -x "$PY" ]] || ! "$PY" -c "import textual" >/dev/null 2>&1; then
  echo "→ Environnement du menu (venv)…"
  if command -v uv >/dev/null 2>&1; then
    uv venv "$HERE/.venv"
    uv pip install --python "$HERE/.venv/bin/python" textual || {
      echo "Impossible d'installer textual. Fallback : $0 --plain"
      exec bash "$HERE/setup-grok-forge.sh"
    }
  else
    python3 -m venv "$HERE/.venv"
    "$HERE/.venv/bin/pip" install -U pip textual || {
      echo "Impossible d'installer textual. Fallback : $0 --plain"
      exec bash "$HERE/setup-grok-forge.sh"
    }
  fi
  PY="$HERE/.venv/bin/python"
fi

if [[ -e /dev/tty ]]; then
  exec </dev/tty "$PY" "$HERE/forge_tui.py" "$@"
else
  exec "$PY" "$HERE/forge_tui.py" "$@"
fi
